[Unit]
Description=Veil 2 - hub di raccordo (relay zero-knowledge)
Documentation=https://scm.hgdump.net/Praelidia/Veil_project
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Togli --tls-dir /etc/veil2/tls se il certificato ce l'hai altrove.
# Aggiungi --hostname miohub.duckdns.org se vuoi che il certificato porti
# il nome giusto: non serve per collegarsi (il client con il pin controlla
# l'impronta, non il nome), ma e' piu' civile se qualcuno ispeziona il TLS.
ExecStart=/usr/bin/python3 /opt/veil2/hub.py --tls-dir /etc/veil2/tls
User=veil2
Group=veil2

# Se l'hub deve ascoltare sulla 443, serve poter legare le porte sotto la
# 1024: si da' solo quell'unica capacita', nient'altro.
# Se invece preferisci una porta alta (es. --porta 8443 sul ExecStart),
# togli entrambe le righe AmbientCapabilities e CapabilityBoundingSet:
# l'hub non ha piu' bisogno di alcuna capacita' particolare.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Il relay non scrive nulla: niente disco, niente log su file. Tutto quello
# che dice va nel journal, che e' gia' li'.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=veil2-hub

# Chiusure pulite: l'hub chiude le connessioni aperte e si ferma.
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

# Chiuso stretto: l'hub non ha bisogno di quasi niente del sistema.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ReadWritePaths=/etc/veil2
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# deve poter aprire socket e legere il proprio certificato: nient'altro
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Limiti: l'hub tiene tutto in RAM, ma non ha bisogno di crescere senza fine
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
